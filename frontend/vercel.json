{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/documents/(.*)", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] }
  ],
  "rewrites": [
    { "source": "/accueil", "destination": "/index.html" },
    { "source": "/projets", "destination": "/index.html" },
    { "source": "/projets/:slug", "destination": "/index.html" },
    { "source": "/competences", "destination": "/index.html" },
    { "source": "/a-propos", "destination": "/index.html" },
    { "source": "/parametres", "destination": "/index.html" }
  ]
}
